{
  "version": 2,
  "functions": {
    "server/server.js": {
      "runtime": "@vercel/node@5"
    }
  },
  "rewrites": [
    { "source": "/api/:path*",        "destination": "/server/server.js" },
    { "source": "/Management/:path*", "destination": "/server/Management/:path*" },
    { "source": "/images/:path*",     "destination": "/client/images/:path*" },
    { "source": "/:path*",            "destination": "/client/:path*" }
  ]
}
