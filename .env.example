# ============================================================
# .env — Environment Variables for Francis Kienji Portfolio
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is already in .gitignore.
# On Vercel: add these in Project → Settings → Environment Variables
# ============================================================

# ── DATABASE (TiDB Cloud) ──────────────────────────────────
# Get these from your TiDB Cloud cluster connection details
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=test
DB_PORT=4000

# ── AUTHENTICATION ─────────────────────────────────────────
# A long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(40).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# ── CONTACT FORM EMAIL (Gmail SMTP) ────────────────────────
# EMAIL_PASS must be a Google APP PASSWORD, not your Gmail login password.
# Your normal password is rejected with "535-5.7.8 Username and Password not accepted".
# Create one at: https://myaccount.google.com/apppasswords (requires 2-Step Verification ON)
# Paste it without spaces (16 characters).
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_google_app_password

# Optional overrides — defaults are smtp.gmail.com:465 and EMAIL_TO=EMAIL_USER
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_TO=frankmk2025@gmail.com

# ── CLOUDINARY (project image uploads) ────────────────────
# Get these from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


