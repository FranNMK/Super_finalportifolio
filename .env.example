# ============================================================
# .env — Environment Variables for Francis Kienji Portfolio
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is already in .gitignore.
# On Vercel: add these in Project → Settings → Environment Variables
# ============================================================

# ── DATABASE (TiDB Cloud) ──────────────────────────────────
# Get these from your TiDB Cloud cluster connection details
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=test
DB_PORT=4000

# ── AUTHENTICATION ─────────────────────────────────────────
# A long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(40).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# ── CONTACT FORM ───────────────────────────────────────────
# No email service is used. Submissions are stored in the
# contact_messages table and read from the admin panel's
# Messages tab, so no extra variables are needed here.

# ── CLOUDINARY (project image uploads) ────────────────────
# Get these from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


